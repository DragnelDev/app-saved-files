PORT=3000
CORS_ORIGIN=http://localhost:5173

DB_HOST=localhost
DB_PORT=5432
DB_NAME=archivo_municipal
DB_USER=postgres
DB_PASSWORD=postgres
# Solo desarrollo: crea/actualiza tablas automaticamente. En produccion usar migraciones.
DB_SYNC=true

JWT_SECRET="cambiar-por-un-secreto-largo-y-aleatorio"
JWT_EXPIRES_IN=8h

# Usuario administrador inicial (se crea una sola vez si no existe)
ADMIN_USERNAME=admin
# Entre comillas: un '#' sin comillas se lee como comentario y recorta el valor
ADMIN_PASSWORD="Cambiar#2026"
ADMIN_NOMBRE=Administrador del Sistema

# Carpeta donde se guardan los PDF de los expedientes (fuera del repositorio)
STORAGE_DIR=./storage
# Encabezado de los reportes PDF
ENTIDAD_NOMBRE="GOBIERNO AUTÓNOMO MUNICIPAL"
