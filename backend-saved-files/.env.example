PORT=3000
CORS_ORIGIN=http://localhost:5173

DB_HOST=localhost
DB_PORT=5432
DB_NAME=archivo_municipal
DB_USER=postgres
DB_PASSWORD=postgres
# false (recomendado, también en la PC de oficina): el esquema se crea y actualiza con las migraciones al arrancar.
# true solo para desarrollo con datos descartables: TypeORM ajusta las tablas solo y puede borrar columnas.
DB_SYNC=false

JWT_SECRET="cambiar-por-un-secreto-largo-y-aleatorio"
JWT_EXPIRES_IN=8h

# Usuario administrador inicial (se crea una sola vez si no existe)
ADMIN_USERNAME=admin
# Entre comillas: un '#' sin comillas se lee como comentario y recorta el valor
ADMIN_PASSWORD="Cambiar#2026"
ADMIN_NOMBRE=Administrador del Sistema

# Carpeta donde se guardan los PDF de los expedientes (fuera del repositorio)
STORAGE_DIR=./storage
# Encabezado de los reportes PDF
ENTIDAD_NOMBRE="GOBIERNO AUTÓNOMO MUNICIPAL"

# Respaldos (npm run respaldo / respaldo.bat): carpeta destino (idealmente un disco externo) y cuántos conservar
RESPALDO_DIR=./respaldos
RESPALDO_CONSERVAR=30
# Si pg_dump / pg_restore no están en el PATH de Windows, indica su ruta completa (carpeta bin de PostgreSQL):
# PG_DUMP="C:/Program Files/PostgreSQL/16/bin/pg_dump.exe"
# PG_RESTORE="C:/Program Files/PostgreSQL/16/bin/pg_restore.exe"
